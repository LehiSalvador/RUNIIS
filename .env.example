# Every variable the code reads. Values are intentionally empty; set them per environment
# (Vercel Project Settings / local .env). Never commit real values.

# Deployment environment: local | staging | production (required; drives health, noindex, rate-limit
# fallbacks and email delivery mode). Unset or unknown fails closed.
APP_ENV=
# Canonical public origin of this deployment, e.g. https://www.runiismty.com (required).
APP_BASE_URL=

# Supabase (required).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server secrets (required, at least 32 characters each). Further PASS_CREDENTIAL_ENCRYPTION_KEY_V<n>
# entries may be added for key rotation; the highest version issues.
PASS_CREDENTIAL_ENCRYPTION_KEY_V1=
INTERNAL_CRON_SECRET=

# Email delivery (optional): live | allowlist | capture. Unset resolves to capture outside production
# and to a hard refuse-to-send in production.
EMAIL_DELIVERY_MODE=
# Comma-separated recipients permitted when EMAIL_DELIVERY_MODE=allowlist.
EMAIL_ALLOWLIST=
BREVO_API_KEY=
BREVO_WEBHOOK_AUTH_SECRET=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Local dev/test only: Mailpit HTTP API used by capture mode.
MAILPIT_URL=

# Public image host (optional): enables next/image for Cloudinary assets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Public map style (optional): defaults to the OpenFreeMap positron style when empty.
NEXT_PUBLIC_MAP_STYLE_URL=
